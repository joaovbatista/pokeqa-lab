# Copie para .env.local e preencha. NUNCA coloque service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_ou_anon_key
# Modo demonstração: habilita o botão "Restaurar dados de demonstração" (padrão: true)
VITE_DEMO_MODE=true
# Desliga a integração com a PokéAPI (a busca externa fica indisponível) (padrão: true)
VITE_ENABLE_POKEAPI=true
